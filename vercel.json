{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "tanstack-start"
    }
  },
  "crons": [{ "path": "/api/images/cleanup", "schedule": "0 0 * * 0" }],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://REPLACE_WITH_AZURE_APP_NAME.azurewebsites.net/api/$1"
    },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
