{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/dist/client",
      "framework": "tanstack-start"
    }
  },
  "crons": [{ "path": "/api/images/cleanup", "schedule": "0 0 * * 0" }],
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "frontend" } }]
}
