# Copy to terraform.tfvars (gitignored) and fill in real values, or pass
# these as TF_VAR_* environment variables / -var flags instead.

environment = "prod"
base_domain = "comerico.davbrito.dev"
# Stable hostname once you've confirmed app-come-rico-prod is free — CI
# deploys reference AZURE_WEBAPP_NAME by fixed value, not a Terraform
# output, so prod shouldn't carry a random suffix.
app_name_unique_suffix = false

# R2 custom domain is storage-<environment>.<base_domain>, e.g.
# storage-prod.comerico.davbrito.dev.

# GitHub — the github provider authenticates via the gh CLI's stored login
# (`gh auth login` once, needs the repo, admin:repo_hook-equivalent scope
# for Environments/Secrets/Variables), no token variable needed here.

# cloudflare_account_id, cloudflare_zone_id, and infisical_project_id are
# the same across workspaces, so they're not set here — copy
# .envrc.example to .envrc at the repo root and fill in TF_VAR_* for them
# instead (along with the Infisical Universal Auth credentials).
#
# Provider tokens (neon_api_key, cloudflare_api_token, vercel_api_token,
# r2_access_key_id, r2_secret_access_key, cron_secret) live in Infisical,
# not here — see infisical.tf and README.md#infisical-provider-tokens.
