# Copy to backend.hcl (gitignored) and fill in real values, then:
#   terraform init -backend-config=backend.hcl
# (add -migrate-state the first time, to move existing local/workspace
# state into R2 — see README.md#remote-state)
#
# Can reuse the same R2 API token as r2_access_key_id/r2_secret_access_key
# in terraform.tfvars, or a separate one scoped to just this bucket
# (Object Read & Write) for tighter isolation.

access_key = "..."
secret_key = "..."
endpoints = {
  s3 = "https://<account_id>.r2.cloudflarestorage.com"
}
